<div
  style="
    font-family: 'Arial', sans-serif;
    max-width: 600px;
    margin: 0 auto;
    padding: 0;
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #e8e8e8;
    overflow: hidden;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  "
>
  <!-- Header Banner -->
  <div
    style="
      background: linear-gradient(135deg, #6c63ff 0%, #6c63ff 100%);
      padding: 30px 20px;
      text-align: center;
    "
  >
    <h1
      style="
        color: white;
        font-size: 20px;
        margin: 0;
        font-weight: 600;
        text-align: center;
        direction: auto;
      "
    >
      <%= msgs.verifyAccount %>
    </h1>
  </div>

  <!-- Content Section -->
  <div style="padding: 30px; text-align: center; direction: auto">
    <p
      style="
        font-size: 13px;
        line-height: 1.6;
        color: #555;
        margin-bottom: 25px;
        text-align: center;
        direction: auto;
      "
    >
      <span
        style="
          font-size: 16px;
          display: block;
          margin-bottom: 6px;
          color: #d1c4e9;
          text-align: center;
          direction: auto;
        "
      >
        <%= msgs.welcome %> <%= username %>,
      </span>
      <%= msgs.thankYouForRegistering %>
    </p>

    <!-- Verification Code Display -->
    <div
      style="
        background: #f8f5ff;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        margin: 30px 0;
        border: 1px dashed #d1c4e9;
        direction: auto;
      "
    >
      <p
        style="
          font-size: 14px;
          color: #666;
          margin: 0 0 10px 0;
          text-align: center;
          direction: auto;
        "
      >
        <%= msgs.verificationCode %>
      </p>
      <div
        style="
          display: inline-block;
          background: #6c63ff;
          color: white;
          font-size: 28px;
          font-weight: 700;
          letter-spacing: 4px;
          padding: 12px 30px;
          border-radius: 6px;
          margin: 10px 0;
          text-align: center;
        "
      >
        <%= otpCode %>
      </div>

      <p
        style="
          font-size: 13px;
          color: #666;
          margin: 15px 0 0 0;
          text-align: center;
          direction: auto;
        "
      >
        <%= msgs.enterCodeInApp %>
      </p>

      <div
        style="
          background: #ffffff;
          border-left: 4px solid #6c63ff;
          padding: 12px 16px;
          border-radius: 4px;
          margin-top: 15px;
          text-align: center;
          direction: auto;
        "
      >
        <p
          style="
            font-size: 11px;
            color: #666;
            margin: 0;
            text-align: center;
            direction: auto;
          "
        >
          <%= msgs.codeWillExpireIn %>
        </p>
      </div>
    </div>

    <!-- Security Notice -->
    <div
      style="
        background: #f8f9fa;
        border-left: 4px solid crimson;
        padding: 12px 16px;
        border-radius: 4px;
        margin-top: 30px;
        text-align: center;
        direction: auto;
      "
    >
      <p
        style="
          font-size: 14px;
          color: #666;
          margin: 0;
          text-align: center;
          direction: auto;
        "
      >
        <strong><%= msgs.note %>:</strong> <%= msgs.ignoreEmailIfNotYou %>
      </p>
    </div>
  </div>

  <!-- Footer -->
  <div
    style="
      text-align: center;
      padding: 20px;
      background: #f9f9f9;
      border-top: 1px solid #eee;
      font-size: 12px;
      color: #999;
      direction: auto;
    "
  >
    <p style="margin: 5px 0; text-align: center; direction: auto">
      <%= msgs.needHelp %>
      <a
        href="mailto:support@company.com"
        style="color: #6c63ff; text-decoration: none"
        ><%= msgs.contactSupport %></a
      >
    </p>
    <p style="margin: 5px 0; text-align: center; direction: auto">
      © <%= new Date().getFullYear() %> <%= appName %>. <%=
      msgs.allRightsReserved %>
    </p>
  </div>
</div>
